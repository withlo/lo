{
  "name": "@lo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./commands": "./src/commands/index.ts",
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css"
  },
  "bin": {
    "lo-check-classes": "./scripts/check-classes.ts"
  },
  "scripts": {
    "codegen": "node scripts/theme.ts && prettier --write src/theme.css",
    "lint": "oxlint && node scripts/check-classes.ts src",
    "test": "vitest run --root ../../.. --project @lo/ui"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/host-grotesk": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@lo/design": "workspace:*",
    "class-variance-authority": "0.7.1",
    "react": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "oxc-parser": "0.158.0",
    "react-dom": "19.3.1"
  },
  "nx": {
    "name": "ui",
    "tags": [
      "platform:desktop"
    ],
    "targets": {
      "codegen": {
        "inputs": [
          "{workspaceRoot}/design/tokens.json",
          "{projectRoot}/scripts/theme.ts"
        ],
        "outputs": [
          "{projectRoot}/src/theme.css"
        ]
      }
    }
  }
}
