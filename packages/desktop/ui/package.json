{
  "name": "@lo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./code": "./src/code/index.ts",
    "./code/view.css": "./src/code/view.css",
    "./commands": "./src/commands/index.ts",
    "./figures": "./src/figures/index.ts",
    "./markdown": "./src/markdown/index.ts",
    "./overview": "./src/overview/index.ts",
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css"
  },
  "bin": {
    "lo-check-classes": "./scripts/check-classes.ts"
  },
  "scripts": {
    "codegen": "node scripts/theme.ts && prettier --write src/theme.css",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "oxlint && stylelint --config ../../../design/stylelint.config.mjs 'src/overview/*.css' && node scripts/check-classes.ts src && node scripts/check-surface.ts",
    "test": "vitest run --root ../../.. --project @lo/ui"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/host-grotesk": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@lo/artifact": "workspace:*",
    "@lo/design": "workspace:*",
    "@lo/diff": "workspace:*",
    "@lo/markdown": "workspace:*",
    "@replit/codemirror-vim": "6.4.0",
    "class-variance-authority": "0.7.1",
    "react": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/oxide": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.3",
    "jsdom": "30.1.3",
    "oxc-parser": "0.158.0",
    "react-dom": "19.3.1",
    "vite": "8.3.7"
  },
  "nx": {
    "name": "ui",
    "tags": [
      "platform:desktop"
    ],
    "targets": {
      "lint": {
        "dependsOn": [
          "^typecheck"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/design/stylelint.config.mjs",
          "{workspaceRoot}/scripts/oxlint/plugin.ts",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          }
        ]
      },
      "codegen": {
        "inputs": [
          "{workspaceRoot}/design/tokens.json",
          "{projectRoot}/scripts/theme.ts"
        ],
        "outputs": [
          "{projectRoot}/src/theme.css"
        ]
      },
      "e2e": {
        "cache": false
      }
    }
  }
}
