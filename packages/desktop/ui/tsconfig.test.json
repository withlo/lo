{
  "extends": "../../../tsconfig.node.json",
  "compilerOptions": {
    "outDir": ".tsbuild/test",
    "lib": ["ES2024", "DOM"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "scripts/**/*.ts",
