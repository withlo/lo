{
  "name": "@withlo/overview",
  "version": "0.1.0",
  "description": "Lo's overview skill for coding agents, and its checker: installs the skill, checks an overview as Lo would, and commits it for its pull request's ref.",
  "keywords": [
    "lo",
    "overview",
    "pull-request",
    "code-review",
    "agent-skills",
    "claude-code",
    "codex"
  ],
  "homepage": "https://github.com/withlo/lo/tree/main/skill",
  "bugs": {
    "url": "https://github.com/withlo/lo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withlo/lo.git",
    "directory": "skill/checker"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "lo-overview": "./dist/checker.js"
  },
  "exports": {
    "./install": "./src/install.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./install": "./dist/install.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.install.config.ts",
    "lint": "oxlint",
    "test": "vitest run --root ../.. --project @withlo/overview"
  },
  "devDependencies": {
    "@lo/artifact": "workspace:*",
    "@lo/skill": "workspace:*",
    "@lo/testing": "workspace:*",
    "vite": "8.3.7"
  },
  "nx": {
    "name": "checker",
    "tags": [
      "license:mit"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/pnpm-lock.yaml"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "test": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/vitest.config.ts",
          {
            "dependentTasksOutputFiles": "**/*"
          }
        ]
      }
    }
  }
}
