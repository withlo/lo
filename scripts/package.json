{
  "name": "@lo/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run --root .. --project @lo/scripts"
  },
  "dependencies": {
    "@nx/devkit": "24.0.5",
    "oxc-parser": "0.158.0",
    "yaml": "2.9.0"
  },
  "nx": {
    "name": "scripts",
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/vitest.config.ts",
          "{workspaceRoot}/.github/workflows/publish.yml"
        ]
      }
    }
  }
}
