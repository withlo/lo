{
  "about": "Hostile Markdown too large to keep as files. Each input is its parts joined, each part a string written that many times. `notes`, when given, is what the tree must say about it.",
  "inputs": [
    {"name": "60,000-deep quotes", "parts": [[">", 60000]], "notes": ["deep"]},
    {"name": "30,000-deep quotes with spaces", "parts": [["> ", 30000], ["x", 1]], "notes": ["deep"]},
    {"name": "30,000-deep lists", "parts": [["- ", 30000], ["x", 1]], "notes": ["deep"]},
    {"name": "20,000-deep ordered lists", "parts": [["1. ", 20000]], "notes": ["deep"]},
    {"name": "quotes in lists in quotes", "parts": [["> - ", 15000], ["x", 1]], "notes": ["deep"]},
    {"name": "mixed containers", "parts": [["> * > 1. ", 7000], ["x", 1]], "notes": ["deep"]},
    {"name": "60,000-deep divs", "parts": [["<div>", 60000]], "notes": ["cut"]},
    {"name": "60,000-deep details", "parts": [["<details>", 7000]]},
    {"name": "nested emphasis", "parts": [["*_", 32000], ["x", 1], ["_*", 32000]]},
    {"name": "unclosed emphasis", "parts": [["*a", 32768]]},
    {"name": "emphasis openers and closers", "parts": [["*a **a ", 4600], ["b", 1], [" a** a*", 4600]]},
    {"name": "unmatched underscores", "parts": [["a_ ", 21845]]},
    {"name": "setext headings", "parts": [["a\n=\n", 16384]]},
    {"name": "www autolinks", "parts": [["www.a_", 10922]]},
    {"name": "link openers", "parts": [["[a", 32768]]},
    {"name": "link closers", "parts": [["a]", 32768]]},
    {"name": "brackets and parentheses", "parts": [["[ (](", 13107]]},
    {"name": "nested brackets", "parts": [["[", 32000], ["a", 1], ["]", 32000]]},
    {"name": "nested images", "parts": [["![", 21000], ["a", 1], ["](b)", 11000]]},
    {"name": "unclosed destinations", "parts": [["[a](<b", 10922]]},
    {"name": "backticks", "parts": [["`", 65536]]},
    {"name": "backtick runs", "parts": [["e`", 30000], ["e``", 10000]]},
    {"name": "wide table", "parts": [["|", 1], ["a|", 16000], ["\n|", 1], ["-|", 16000], ["\n|", 1], ["b|", 16000]]},
    {"name": "long table", "parts": [["|a|b|\n|-|-|\n", 1], ["|x|y|\n", 13000]]},
    {"name": "pipes", "parts": [["|", 65536]]},
    {"name": "mentions", "parts": [["@a ", 21845]]},
    {"name": "at signs", "parts": [["@", 65536]]},
    {"name": "references", "parts": [["#1 ", 21845]]},
    {"name": "hashes", "parts": [["#", 65536]]},
    {"name": "cross-repository references", "parts": [["a/b#1 ", 10922]]},
    {"name": "long repository names", "parts": [["a", 99], ["/", 1], ["b", 99], ["#1 ", 1], ["a/b#1 ", 10000]]},
    {"name": "one long address by reference", "parts": [["[a]: https://e.com/", 1], ["x", 8000], ["\n\n", 1], ["[a]", 19000]]},
    {"name": "one long image by reference", "parts": [["[a]: https://camo.githubusercontent.com/", 1], ["x", 8000], ["\n\n", 1], ["![a][a]", 8000]]},
    {"name": "one huge address by reference", "parts": [["[a]: data:", 1], ["A", 60000], ["\n\n", 1], ["[a]", 1800]]},
    {"name": "one anchor by reference", "parts": [["# ", 1], ["h", 8000], ["\n\n[a]: #", 1], ["h", 8000], ["\n\n", 1], ["[a]", 15000]]},
    {"name": "footnote references", "parts": [["[^a]", 16000], ["\n\n[^a]: b", 1]]},
    {"name": "images", "parts": [["![a](https://camo.githubusercontent.com/a)", 1500]]},
    {"name": "html comments", "parts": [["<!--", 16384]]},
    {"name": "inline html comments", "parts": [["a <!-- b", 8192]]},
    {"name": "html tags", "parts": [["<a ", 21845]]},
    {"name": "inline tags", "parts": [["<b>", 21845]]},
    {"name": "nul characters", "parts": [["\u0000", 65536]]},
    {"name": "lone surrogates", "parts": [["\ud800", 65536]]},
    {"name": "carriage returns", "parts": [["a\r\n", 21845]]},
    {"name": "hard breaks", "parts": [["a  \n", 16384]]},
    {"name": "headings", "parts": [["# a\n", 16384]]},
    {"name": "repeated headings", "parts": [["# a\n\n", 13107]]},
    {"name": "entities", "parts": [["&#9999999;", 6553]]},
    {"name": "escapes", "parts": [["\\", 65536]]},
    {"name": "fence openers", "parts": [["```\n", 16384]]},
    {"name": "indented code", "parts": [["    a\n\n", 9362]]},
    {"name": "lazy quote lines", "parts": [["> a\nb\n", 10922]]},
    {"name": "list items", "parts": [["- a\n", 16384]]},
    {"name": "task items", "parts": [["- [x] a\n", 8192]]},
    {"name": "alerts", "parts": [["> [!NOTE]\n> a\n\n", 4369]]},
    {"name": "ten million characters", "parts": [["a", 10000000]], "notes": ["cut"]},
    {"name": "two million lines", "parts": [["a\n", 2000000]], "notes": ["cut", "nodes"]}
  ]
}
