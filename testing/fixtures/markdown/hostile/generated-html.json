{
  "about": "Hostile HTML too large to keep as files. Each input is its parts joined, each part a string written that many times, `{i}` in it standing for the time it is written, from 0. Each is given as a post whose Markdown is `fallback`. `notes`, when given, is what the tree must say about it.",
  "inputs": [
    {"name": "60,000-deep divs", "parts": [["<div>", 60000], ["x", 1]], "notes": ["deep"]},
    {"name": "100,000-deep spans", "parts": [["<span>", 100000], ["x", 1]], "notes": ["deep"]},
    {"name": "80,000-deep quotes", "parts": [["<blockquote>", 80000], ["x", 1]], "notes": ["deep"]},
    {"name": "50,000-deep lists", "parts": [["<ul><li>", 50000], ["x", 1]], "notes": ["deep"]},
    {"name": "30,000-deep tables", "parts": [["<table><tr><td>", 30000], ["x", 1]], "notes": ["deep"]},
    {"name": "deep formatting", "parts": [["<b><i><u><s><em><strong><code>", 15000], ["x", 1]], "notes": ["deep"]},
    {"name": "deep alerts", "parts": [["<div class=\"markdown-alert markdown-alert-note\">", 20000], ["x", 1]], "notes": ["deep"]},
    {"name": "deep details", "parts": [["<details><summary>s</summary>", 30000], ["x", 1]], "notes": ["deep"]},
    {"name": "deep links", "parts": [["<a href=\"https://e.com/\">", 30000], ["x", 1]]},
    {"name": "formatting rebuilt for every run of text", "parts": [["<p>", 1], ["<b id={i}>", 1000], ["</p>x", 1000]]},
    {"name": "formatting rebuilt a million times", "parts": [["<div>", 200], ["<b id={i}>", 1000], ["</div>x", 200]]},
    {"name": "misnested formatting", "parts": [["<b><i></b></i>", 60000]]},
    {"name": "formatting and links", "parts": [["<a><b><a><b>", 30000]]},
    {"name": "foster parenting", "parts": [["<table>x<div>", 60000]]},
    {"name": "many attributes", "parts": [["<div ", 1], ["a=1 ", 250000], [">x", 1]]},
    {"name": "one huge attribute", "parts": [["<div title=\"", 1], ["x", 1000000], ["\">y", 1]]},
    {"name": "many paragraphs", "parts": [["<p>a</p>", 120000]], "notes": ["nodes"]},
    {"name": "many images", "parts": [["<img src=\"https://camo.githubusercontent.com/{i}\" alt=\"i\">", 15000]]},
    {"name": "many remote images", "parts": [["<img src=\"https://evil.example/{i}.png\" alt=a>", 20000]]},
    {"name": "many links", "parts": [["<a href=\"https://e.com/{i}\">a</a>", 30000]]},
    {"name": "one long address", "parts": [["<a href=\"https://e.com/", 1], ["x", 9000], ["\">a</a>", 1]]},
    {"name": "many footnote references", "parts": [["<sup><a href=\"#user-content-fn-1\" data-footnote-ref>1</a></sup>", 15000], ["<section data-footnotes><ol><li id=\"user-content-fn-1\"><p>n</p></li></ol></section>", 1]]},
    {"name": "many footnotes", "parts": [["<section data-footnotes><ol>", 1], ["<li id=\"user-content-fn-{i}\"><p>n</p></li>", 20000], ["</ol></section>", 1]], "notes": ["nodes"]},
    {"name": "many headings", "parts": [["<h2>a</h2>", 100000]], "notes": ["nodes"]},
    {"name": "comments", "parts": [["<!--", 200000]]},
    {"name": "entities", "parts": [["&amp;&lt;&#x1F600;&notin", 40000]]},
    {"name": "nul characters", "parts": [["\u0000", 1000000]]},
    {"name": "lone surrogates", "parts": [["\ud800", 300000]]},
    {"name": "whitespace", "parts": [[" \n\t", 340000]]},
    {"name": "breaks", "parts": [["x<br>", 100000]], "notes": ["nodes"]},
    {"name": "one byte past the limit", "parts": [["a", 1048577]]},
    {"name": "far past the limit", "parts": [["<div>", 2000000]]}
  ]
}
