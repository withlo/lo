        "patch": "@@ -0,0 +1,6 @@\n+import { retry } from './retry.ts';\n+\n+/** Reads `path`, trying three times when a read times out. */\n+export function read(path: string, fetch: (path: string) => Promise<string>): Promise<string> {\n+  return retry(() => fetch(path), 3);\n+}"
