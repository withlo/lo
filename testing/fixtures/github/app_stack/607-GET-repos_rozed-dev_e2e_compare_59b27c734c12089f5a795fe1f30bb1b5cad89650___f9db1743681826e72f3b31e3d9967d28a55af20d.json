          "sha": "653061cf96e8207374bde16297807734da8cd603",
          "filename": "src/cost.ts",
          "status": "added",
          "additions": 11,
          "deletions": 0,
          "changes": 11,
          "blob_url": "https://github.com/rozed-dev/e2e/blob/f9db1743681826e72f3b31e3d9967d28a55af20d/src%2Fcost.ts",
          "raw_url": "https://github.com/rozed-dev/e2e/raw/f9db1743681826e72f3b31e3d9967d28a55af20d/src%2Fcost.ts",
          "contents_url": "https://api.github.com/repos/rozed-dev/e2e/contents/src%2Fcost.ts?ref=f9db1743681826e72f3b31e3d9967d28a55af20d",
          "patch": "@@ -0,0 +1,11 @@\n+import type { Limit } from './limits.ts';\n+\n+/** What GitHub charges for a query: one point for each 100 nodes it may read, at least one. */\n+export function costOf(nodes: number): number {\n+  return Math.max(1, Math.ceil(nodes / 100));\n+}\n+\n+/** Whether a query of `nodes` fits in what's left of `limit` after `spent` points. */\n+export function fits(limit: Limit, spent: number, nodes: number): boolean {\n+  return spent + costOf(nodes) <= limit.points;\n+}"
        },
        {
          "sha": "ce3bf32308e20e116ecf19b0ce00cb2863fd37b0",
          "filename": "src/nodes.ts",
          "status": "added",
          "additions": 4,
          "deletions": 0,
          "changes": 4,
          "blob_url": "https://github.com/rozed-dev/e2e/blob/f9db1743681826e72f3b31e3d9967d28a55af20d/src%2Fnodes.ts",
          "raw_url": "https://github.com/rozed-dev/e2e/raw/f9db1743681826e72f3b31e3d9967d28a55af20d/src%2Fnodes.ts",
          "contents_url": "https://api.github.com/repos/rozed-dev/e2e/contents/src%2Fnodes.ts?ref=f9db1743681826e72f3b31e3d9967d28a55af20d",
          "patch": "@@ -0,0 +1,4 @@\n+/** How many nodes a connection of `first` items, each with `inner` items of its own, may read. */\n+export function nodesOf(first: number, inner = 0): number {\n+  return first + first * inner;\n+}"
        }
