{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "outDir": ".tsbuild/main",
    "types": ["node", "vite/client", "electron-vite/node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/platform/**/*.ts",
    "src/features/*/main/**/*.ts",
    "src/features/*/service.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/test/**"],
  "references": [
    {
      "path": "../../packages/core/artifact"
    },
    {
      "path": "../../packages/core/review"
    },
    {
      "path": "./tsconfig.shared.json"
    }
  ]
}
