{
  "name": "@lo/desktop",
  "productName": "Lo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "codegen": "node scripts/keys.ts && prettier --write ../../docs/keys.md",
    "dev": "electron-vite dev",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "oxlint && lo-check-classes src",
    "package": "electron-builder --config build/electron-builder.yml --mac",
    "start": "electron .",
    "test": "vitest run --root ../.. --project @lo/desktop"
  },
  "dependencies": {
    "@lo/design": "workspace:*",
    "@lo/git": "workspace:*",
    "@lo/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lo/testing": "workspace:*",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "vite": "8.3.7"
  },
  "nx": {
    "name": "desktop",
    "targets": {
      "codegen": {
        "inputs": [
          "{projectRoot}/scripts/keys.ts",
          "{projectRoot}/src/features/*/keys.ts",
          "{projectRoot}/src/window/commands/declarations.ts",
          "^production",
          "{workspaceRoot}/.prettierrc.json"
        ],
        "outputs": [
          "{workspaceRoot}/docs/keys.md"
        ]
      },
      "start": {
        "dependsOn": [
          "build"
        ]
      },
      "e2e": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      },
      "package": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      }
    }
  }
}
