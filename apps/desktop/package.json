{
  "name": "@lo/desktop",
  "productName": "Lo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "oxlint",
    "start": "electron .",
    "test": "vitest run --root ../.. --project @lo/desktop"
  },
  "dependencies": {
    "@lo/design": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-vite": "6.0.0",
    "vite": "8.3.7"
  },
  "nx": {
    "name": "desktop",
    "targets": {
      "start": {
        "dependsOn": [
          "build"
        ]
      },
      "e2e": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      }
    }
  }
}
