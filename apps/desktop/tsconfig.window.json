{
  "extends": "../../tsconfig.window.json",
  "compilerOptions": {
    "outDir": ".tsbuild/window",
    "types": ["vite/client"]
  },
  "include": [
    "src/window/**/*.ts",
    "src/window/**/*.tsx",
    "src/features/*/window/**/*.ts",
    "src/features/*/window/**/*.tsx",
    "src/features/*/keys.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/test/**"],
  "references": [
    {
      "path": "../../packages/core/review"
    },
    {
      "path": "./tsconfig.shared.json"
    }
  ]
}
