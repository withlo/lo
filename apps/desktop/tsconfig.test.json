{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "outDir": ".tsbuild/test",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/test/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts"
  ],
  "references": [
    {
      "path": "../../packages/core/artifact"
    },
    {
      "path": "../../packages/core/review"
    },
    {
      "path": "./tsconfig.shared.json"
    },
    {
      "path": "./tsconfig.main.json"
    },
    {
      "path": "./tsconfig.window.json"
    },
    {
      "path": "./tsconfig.background.json"
    }
  ]
}
