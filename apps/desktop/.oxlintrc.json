{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:sqlite",
            "message": "Use the Database from src/main/database.ts, the only module that uses node:sqlite."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/main/database.ts", "e2e/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/ipc/**", "src/features/*/contract.ts", "src/features/*/jobs.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Contracts are shared by main and the window, so they import neither Electron nor Node."
              }
            ],
            "patterns": [
              {
                "group": ["electron/*", "node:*"],
                "message": "Contracts are shared by main and the window, so they import neither Electron nor Node."
              },
              {
                "group": ["**/main/**", "**/window/**", "**/preload/**", "**/platform/**"],
                "message": "A contract imports only other shared code: src/ipc/ and Zod."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/keys.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "A feature's keys.ts is plain data that Node reads: it imports only @lo/ui/commands."
              }
            ],
            "patterns": [
              {
                "group": ["electron/*", "node:*"],
                "message": "A feature's keys.ts is plain data that Node reads: it imports only @lo/ui/commands."
              },
              {
                "group": [
                  "**/main/**",
                  "**/window/**",
                  "**/preload/**",
                  "**/platform/**",
                  "**/background/**"
                ],
                "message": "A feature's keys.ts is plain data that Node reads: it imports only @lo/ui/commands."
              }
            ]
          }
        ]
      }
    }
  ]
}
