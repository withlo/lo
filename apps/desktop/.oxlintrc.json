{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:sqlite",
            "message": "Use the Database from src/main/database.ts, the only module that uses node:sqlite."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/main/database.ts", "e2e/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
