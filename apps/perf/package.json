{
  "name": "@lo/perf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "fetch": "node scripts/fetch.ts",
    "lint": "oxlint",
    "open": "electron .",
    "record": "node scripts/record.ts",
    "test": "vitest run --root ../.. --project @lo/perf"
  },
  "dependencies": {
    "@lo/design": "workspace:*",
    "@lo/diff": "workspace:*",
    "@lo/syntax": "workspace:*",
    "@lo/ui": "workspace:*",
    "web-tree-sitter": "0.27.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "vite": "8.3.7"
  },
  "nx": {
    "name": "perf",
    "targets": {
      "open": {
        "dependsOn": [
          "build",
          "fetch"
        ],
        "cache": false
      }
    }
  }
}
